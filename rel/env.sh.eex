#!/bin/sh

if [ -n "${FLY_APP_NAME:-}" ] && [ -n "${FLY_PRIVATE_IP:-}" ] && [ -n "${FLY_IMAGE_REF:-}" ]; then
  export ERL_AFLAGS="${ERL_AFLAGS:--proto_dist inet6_tcp}"
  export ECTO_IPV6="${ECTO_IPV6:-true}"
  export DNS_CLUSTER_QUERY="${DNS_CLUSTER_QUERY:-${FLY_APP_NAME}.internal}"
  export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
  export RELEASE_NODE="${RELEASE_NODE:-${FLY_APP_NAME}-${FLY_IMAGE_REF##*-}@${FLY_PRIVATE_IP}}"
else
  export ECTO_IPV6="${ECTO_IPV6:-false}"
  export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
fi
