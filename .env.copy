# get Replicate token at https://replicate.com
export REPLICATE_API_TOKEN=your_replicate_api_token

# image provider: replicate or openai
export IMAGE_PROVIDER=openai

# OpenAI-compatible image API
export OPENAI_API_KEY=your_openai_api_key
export OPENAI_BASE_URL=https://api.guide.christmas/v1
export OPENAI_IMAGE_MODEL=gpt-image-2

# Stripe checkout
export STRIPE_SECRET_KEY=
export STRIPE_WEBHOOK_SECRET=
export STRIPE_STARTER_PRICE_ID=
export STRIPE_CREATOR_PRICE_ID=

# launch ngrok with `ngrok http 4000`
export NGROK_URL=

# required for the /admin page
export ADMIN_USERNAME=
export ADMIN_PASSWORD=

# config for https://www.tigrisdata.com
export AWS_ACCESS_KEY_ID=
export AWS_ENDPOINT_URL_S3=
export AWS_REGION=
export AWS_SECRET_ACCESS_KEY=
export BUCKET_NAME==
export AWS_PUBLIC_URL=
