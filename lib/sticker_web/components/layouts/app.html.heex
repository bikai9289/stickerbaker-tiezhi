<header class="saas-nav">
  <div class="saas-container saas-nav-inner">
    <.link class="saas-brand" navigate={~p"/"}>
      <span class="saas-logo-sticker"><span>*</span></span> <span>AI Sticker Maker</span>
    </.link>

    <nav class="saas-nav-links" aria-label="Primary navigation">
      <a href="/#generator">Generator</a> <a href="/?mode=portrait#generator">Upload</a>
      <a href="/#latest">Latest</a> <.link navigate={~p"/pricing"}>Pricing</.link>
      <a href="/#faq">FAQ</a>
    </nav>

    <div class="saas-nav-actions">
      <%= if @current_user do %>
        <span class="saas-credit-pill">Credits: <%= @current_user.credits %></span>
        <span class="saas-user-email"><%= @current_user.email %></span>
        <.link class="saas-button saas-button-ghost" navigate={~p"/account"}>Account</.link>
        <.link class="saas-button saas-button-ghost" href={~p"/users/log-out"} method="delete">
          Sign Out
        </.link>
      <% else %>
        <.link
          class="saas-button saas-button-ghost"
          navigate={~p"/users/log-in"}
          data-analytics-event="login_cta_click"
          data-analytics-context="nav"
        >
          Sign In
        </.link>

        <.link
          class="saas-button saas-button-primary"
          navigate={~p"/users/register"}
          data-analytics-event="registration_cta_click"
          data-analytics-context="nav"
        >
          Create Account
        </.link>
      <% end %>
    </div>
  </div>
</header>

<main>
  <.flash_group flash={@flash} /> <%= @inner_content %>
</main>

<footer class="saas-footer">
  <div class="saas-container saas-footer-grid">
    <div class="saas-footer-about">
      <.link class="saas-footer-brand" navigate={~p"/"}>
        <span class="saas-logo-sticker"><span>*</span></span> <span>AI Sticker Maker</span>
      </.link>

      <p>
        Create custom stickers from text or portraits, manage completed results in your history,
        and download your designs as PNG or WebP files.
      </p>

      <.link
        class="saas-footer-badge"
        navigate={~p"/pricing"}
        data-analytics-event="pricing_cta_click"
        data-analytics-context="footer_badge"
      >
        Buy Credits
      </.link>
    </div>

    <div>
      <h3>Product</h3>

      <div class="saas-footer-links">
        <a href="/#generator">AI Sticker Generator</a>
        <a href="/?mode=portrait#generator">Face to Sticker</a>
        <.link navigate={~p"/custom-sticker-maker"}>Custom Sticker Maker</.link>
        <.link navigate={~p"/cute-sticker-ideas"}>Cute Sticker Ideas</.link>
        <.link navigate={~p"/sticker-maker-online"}>Sticker Maker Online</.link>
        <.link navigate={~p"/ai-avatar-sticker"}>AI Avatar Sticker</.link>
        <.link navigate={~p"/kawaii-sticker-maker"}>Kawaii Sticker Maker</.link>
        <.link navigate={~p"/transparent-sticker-maker"}>Transparent Sticker Maker</.link>
        <a href="/#latest">Latest Stickers</a> <.link navigate={~p"/account"}>Account</.link>
        <.link
          navigate={~p"/pricing"}
          data-analytics-event="pricing_cta_click"
          data-analytics-context="footer_product"
        >
          Buy Credits
        </.link>
      </div>
    </div>

    <div>
      <h3>Resources</h3>

      <div class="saas-footer-links">
        <a href="/#faq">FAQ</a> <a href="/search">Prompt Ideas</a>
        <a href="/search">Sticker Examples</a>
      </div>
    </div>

    <div>
      <h3>Company</h3>

      <div class="saas-footer-links">
        <a href="mailto:support@ai-sticker-maker.com">support@ai-sticker-maker.com</a>
        <.link navigate={~p"/contact"}>Contact</.link>
        <.link navigate={~p"/payment-and-credits"}>Payment and Credits</.link>
        <.link navigate={~p"/refund-policy"}>Refund Policy</.link>
        <.link navigate={~p"/privacy-policy"}>Privacy Policy</.link>
        <.link navigate={~p"/terms-of-service"}>Terms of Service</.link>
        <.link navigate={~p"/sitemap"}>Sitemap</.link>
      </div>
    </div>
  </div>

  <div class="saas-container saas-copyright">
    &copy; 2026 AI-Sticker-Maker.com. All rights reserved.
  </div>
</footer>
