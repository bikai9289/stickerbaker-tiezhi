<header class="saas-nav">
  <div class="saas-container saas-nav-inner">
    <.link class="saas-brand" navigate={~p"/"}>
      <span class="saas-logo-sticker"><span>*</span></span>
      <span>AI Sticker Maker</span>
    </.link>

    <nav class="saas-nav-links" aria-label="Primary navigation">
      <a href="/#generator">Generator</a>
      <a href="/#upload">Upload</a>
      <a href="/#latest">Latest</a>
      <a href="/#pricing">Pricing</a>
      <a href="/#faq">FAQ</a>
    </nav>

    <div class="saas-nav-actions">
      <a class="saas-button saas-button-ghost" href="#signin">Sign In</a>
      <a class="saas-button saas-button-primary" href="/#generator">Start Free</a>
    </div>
  </div>
</header>

<main>
  <.flash_group flash={@flash} />
  <%= @inner_content %>
</main>
