<section class="saas-auth-page">
  <div class="saas-auth-card">
    <p class="saas-legal-kicker">Start free</p>

    <h1>Create your AI Sticker Maker account</h1>

    <p class="saas-auth-copy">
      Sign up to keep your sticker history, manage credits, and download generated stickers.
    </p>

    <.form
      :let={f}
      for={@changeset}
      as={:user}
      action={~p"/users/register"}
      class="saas-auth-form"
      data-analytics-event="registration_confirm_attempt"
      data-analytics-context={
        if assigns[:pending_prompt?], do: "registration_from_prompt", else: "registration_form"
      }
    >
      <label>
        <span>Email</span>
        <input
          type="email"
          name={f[:email].name}
          value={Phoenix.HTML.Form.normalize_value("email", f[:email].value)}
          autocomplete="email"
          required
          class="saas-auth-input"
        />
        <.error :for={msg <- f[:email].errors}><%= translate_error(msg) %></.error>
      </label>

      <label>
        <span>Password</span>
        <input
          type="password"
          name={f[:password].name}
          autocomplete="new-password"
          minlength="8"
          required
          class="saas-auth-input"
        />
        <.error :for={msg <- f[:password].errors}><%= translate_error(msg) %></.error>
      </label>

      <label>
        <span>Captcha security check: <%= @captcha_question %></span>
        <input
          type="text"
          name="captcha_answer"
          inputmode="numeric"
          autocomplete="off"
          required
          class="saas-auth-input"
        />
      </label>

      <p class="saas-auth-copy">
        Confirm your email after signup to unlock your remaining free sticker credits.
      </p>

      <button class="saas-button saas-button-primary saas-auth-submit">
        Create Account
      </button>
    </.form>

    <p class="saas-auth-switch">
      Already have an account?
      <.link
        navigate={~p"/users/log-in"}
        data-analytics-event="login_cta_click"
        data-analytics-context="registration_page"
      >
        Sign in
      </.link>
    </p>
  </div>
</section>
