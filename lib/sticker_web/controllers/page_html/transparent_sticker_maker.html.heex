<section class="saas-legal-page">
  <div class="saas-container saas-page-shell">
    <div class="saas-page-hero">
      <p class="saas-legal-kicker">Sticker Downloads</p>
      <h1>Transparent Sticker Maker</h1>
      <p>
        Generate sticker-style images and download files as PNG or WebP. Use PNG for broad editing
        compatibility and WebP for smaller web assets.
      </p>
      <a class="saas-button saas-button-primary" href="/#generator">Generate Sticker Files</a>
    </div>

    <div class="saas-info-grid">
      <article class="saas-info-panel">
