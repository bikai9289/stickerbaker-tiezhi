<section class="saas-legal-page">
  <div class="saas-container saas-page-shell">
    <div class="saas-page-hero">
      <p class="saas-legal-kicker">Billing</p>
      <h1>Refund Policy</h1>
      <p>
        We want credit purchases to be clear and fair. Contact support if a checkout, account, or
        generation issue prevents you from using purchased credits.
      </p>
    </div>

    <div class="saas-policy-list">
      <article class="saas-info-panel">
        <h2>Unused credits</h2>
        <p>
          Refund requests for unused purchased credits can be reviewed within 14 days of purchase.
          Include your account email and checkout receipt when contacting support.
        </p>
      </article>

      <article class="saas-info-panel">
        <h2>Generated results</h2>
        <p>
          AI generation results can vary. Credits used for completed generation requests are
          normally not refundable, but we may review clear technical failures.
        </p>
      </article>

      <article class="saas-info-panel">
        <h2>Contact</h2>
        <p>
          Send refund or billing questions to
          <a href="mailto:support@ai-sticker-maker.com">support@ai-sticker-maker.com</a>.
        </p>
      </article>
    </div>
  </div>
</section>
