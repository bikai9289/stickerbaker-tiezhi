<section class="saas-legal-page">
  <div class="saas-container saas-page-shell">
    <div class="saas-page-hero">
      <p class="saas-legal-kicker">Sitemap</p>
      <h1>Site Map</h1>
      <p>
        Use these links to reach the main product, account, billing, support, and policy pages.
      </p>
    </div>

    <div class="saas-info-grid">
      <article class="saas-info-panel">
        <h2>Product</h2>
        <div class="saas-page-links">
          <.link navigate={~p"/"}>AI Sticker Generator</.link>
          <.link navigate={~p"/search"}>Sticker Search</.link>
          <.link navigate={~p"/sticker-maker-online"}>Sticker Maker Online</.link>
          <.link navigate={~p"/photo-to-sticker"}>Photo to Sticker</.link>
          <.link navigate={~p"/reaction-sticker-maker"}>Reaction Sticker Maker</.link>
          <.link navigate={~p"/ai-avatar-sticker"}>AI Avatar Sticker</.link>
          <.link navigate={~p"/anime-avatar-sticker"}>Anime Avatar Sticker</.link>
          <.link navigate={~p"/kawaii-sticker-maker"}>Kawaii Sticker Maker</.link>
          <.link navigate={~p"/transparent-sticker-maker"}>Transparent Sticker Maker</.link>
          <.link navigate={~p"/pricing"}>Pricing</.link>
        </div>
      </article>

      <article class="saas-info-panel">
        <h2>Account</h2>
        <div class="saas-page-links">
          <.link navigate={~p"/users/register"}>Create Account</.link>
          <.link navigate={~p"/users/log-in"}>Sign In</.link>
          <.link navigate={~p"/account"}>Account</.link>
          <.link navigate={~p"/stickers"}>Sticker History</.link>
        </div>
      </article>

      <article class="saas-info-panel">
        <h2>Support</h2>
        <div class="saas-page-links">
          <.link navigate={~p"/contact"}>Contact</.link>
          <.link navigate={~p"/payment-and-credits"}>Payment and Credits</.link>
          <.link navigate={~p"/refund-policy"}>Refund Policy</.link>
        </div>
      </article>

      <article class="saas-info-panel">
        <h2>Legal</h2>
        <div class="saas-page-links">
          <.link navigate={~p"/privacy-policy"}>Privacy Policy</.link>
          <.link navigate={~p"/terms-of-service"}>Terms of Service</.link>
          <a href="/sitemap.xml">XML Sitemap</a>
        </div>
      </article>
    </div>
  </div>
</section>
