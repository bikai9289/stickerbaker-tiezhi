<section class="saas-pricing-page">
  <div class="saas-container">
    <div class="saas-pricing-hero">
      <p class="saas-legal-kicker">Pricing</p>
      <h1>Buy AI Sticker Credits</h1>
      <p>
        Start with 3 free credits. Add more credits with secure checkout, then keep generating
        text and face stickers from the same account.
      </p>
    </div>

    <div class="saas-buy-grid">
      <article class="saas-buy-card">
        <h2>Free</h2>
        <div class="saas-buy-price">$0</div>
        <p>3 credits for every new account.</p>
        <.link class="saas-button saas-button-ghost" navigate={~p"/users/register"}>
          Start Free
        </.link>
      </article>

      <article class="saas-buy-card featured">
        <div class="saas-plan-badge">Popular</div>
        <h2>Starter</h2>
        <div class="saas-buy-price">$4.99</div>
        <p>50 credits for testing prompts, social stickers, and small creative batches.</p>
        <.form action={~p"/checkout"} method="post">
          <input type="hidden" name="plan" value="starter" />
          <button class="saas-button saas-button-primary saas-plan-button">
            Buy 50 Credits
          </button>
        </.form>
      </article>

      <article class="saas-buy-card">
        <h2>Creator</h2>
        <div class="saas-buy-price">$9.99</div>
        <p>150 credits for frequent generation, variations, and content experiments.</p>
        <.form action={~p"/checkout"} method="post">
          <input type="hidden" name="plan" value="creator" />
          <button class="saas-button saas-button-ghost saas-plan-button">
            Buy 150 Credits
          </button>
        </.form>
      </article>
    </div>

    <div class="saas-buy-note">
      <strong>Account checkout:</strong>
      Sign in before purchase so completed payments can add credits to the right account.
    </div>
  </div>
</section>
