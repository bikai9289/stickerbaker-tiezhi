<section class="saas-legal-page">
  <div class="saas-container saas-page-shell">
    <div class="saas-page-hero">
      <p class="saas-legal-kicker">Payments</p>
      <h1>Payment and Credits</h1>
      <p>
        AI Sticker Maker uses account credits for text and face sticker generation. Each successful
        generation request uses 1 credit.
      </p>
    </div>

    <div class="saas-policy-list">
      <article class="saas-info-panel">
        <h2>How credits work</h2>
        <p>
          New accounts receive 3 free credits. Paid plans add credits to the signed-in account used
          at checkout after payment confirmation.
        </p>
      </article>

      <article class="saas-info-panel">
        <h2>Secure checkout</h2>
        <p>
          Credit purchases are processed through a secure checkout provider. We do not store full
          card details on our servers.
        </p>
      </article>

      <article class="saas-info-panel">
        <h2>Billing support</h2>
        <p>
          For receipt, checkout, or credit issues, contact
          <a href="mailto:support@ai-sticker-maker.com">support@ai-sticker-maker.com</a>.
        </p>
      </article>
    </div>
  </div>
</section>
