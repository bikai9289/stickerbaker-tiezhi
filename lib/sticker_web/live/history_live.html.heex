<div id="history" phx-hook="AssignUserId" data-session-user-id={@local_user_id}>
  <section class="saas-section">
    <div class="saas-container">
      <div class="saas-section-head">
        <h1>Sticker History</h1>
        <p class="saas-section-copy">
          Track completed, processing, and failed generations. Download, save, regenerate,
          create variations, or remove stickers from your account.
        </p>
      </div>

      <p :if={is_nil(@local_user_id)} class="saas-loading">
        <img src="/images/loading.png" alt="loading" /> Loading your stickers...
      </p>

      <.form :if={@local_user_id} for={%{}} phx-change="filter" class="saas-history-toolbar">
        <input
          type="search"
          name="query"
          value={@filters.query}
          placeholder="Search your sticker history"
          class="saas-history-search"
        />
        <select name="status" class="saas-history-select">
          <option value="all" selected={@filters.status == "all"}>All</option>
          <option value="completed" selected={@filters.status == "completed"}>Completed</option>
          <option value="processing" selected={@filters.status == "processing"}>Processing</option>
          <option value="failed" selected={@filters.status == "failed"}>Failed</option>
          <option value="canceled" selected={@filters.status == "canceled"}>Canceled</option>
          <option value="favorites" selected={@filters.status == "favorites"}>Favorites</option>
        </select>
        <select name="batch_id" class="saas-history-select">
          <option value="all" selected={@filters.batch_id == "all"}>All batches</option>
          <option
            :for={batch <- @batches}
            value={batch.batch_id}
            selected={@filters.batch_id == batch.batch_id}
          >
            <%= batch_label(batch) %>
          </option>
        </select>
      </.form>

      <div :if={not is_nil(@local_user_id) and MapSet.size(@selected_ids) > 0} class="saas-history-bulk">
        <strong><%= MapSet.size(@selected_ids) %> selected</strong>
        <button
          class={if @download_format == "original", do: "active", else: nil}
          phx-click="set-download-format"
          phx-value-format="original"
        >
          Original
        </button>
        <button
          class={if @download_format == "png", do: "active", else: nil}
          phx-click="set-download-format"
          phx-value-format="png"
        >
          PNG
        </button>
        <button
          class={if @download_format == "webp", do: "active", else: nil}
          phx-click="set-download-format"
          phx-value-format="webp"
        >
          WebP
        </button>
        <.link
          href={~p"/stickers/download?ids=#{selected_ids_param(@selected_ids)}&format=#{download_format_param(@download_format)}"}
          data-analytics-event="download_click"
          data-analytics-context="history_bulk"
          data-analytics-download-type="batch_zip"
          data-analytics-format={download_format_param(@download_format)}
        >
          Download ZIP
        </.link>
        <button phx-click="delete-selected">Delete Selected</button>
        <button phx-click="clear-selection">Clear</button>
      </div>

      <div :if={@batches != []} class="saas-batch-summary">
        <article :for={batch <- Enum.take(@batches, 4)}>
          <.link navigate={~p"/stickers/batches/#{batch.batch_id}"}>
            <strong><%= batch_label(batch) %></strong>
          </.link>
          <span><%= batch.processing %> processing</span>
        </article>
      </div>

      <ul
        :if={not is_nil(@local_user_id)}
        id="predictions"
        phx-update="stream"
        role="list"
        class="saas-generated-grid"
      >
        <li :for={{id, prediction} <- @streams.predictions} id={id}>
          <div class="saas-history-item">
            <label class="saas-history-check">
              <input
                type="checkbox"
                checked={selected?(@selected_ids, prediction.id)}
                phx-click="toggle-select"
                phx-value-id={prediction.id}
              />
              <span>Select</span>
            </label>
            <StickerWeb.Components.sticker id={id} prediction={prediction} class="saas-generated-item" />
            <div class="saas-history-actions">
              <button phx-click="toggle-favorite" phx-value-id={prediction.id}>
                <%= if prediction.is_favorite, do: "Saved", else: "Save" %>
              </button>
              <.link
                :if={prediction.sticker_output}
                href={~p"/sticker/#{prediction.id}/download"}
                data-analytics-event="download_click"
                data-analytics-context="history_item"
                data-analytics-download-type="single"
                data-analytics-format="original"
              >
                Download
              </.link>
              <button
                :if={failed_or_canceled?(prediction)}
                phx-click="retry"
                phx-value-id={prediction.id}
              >
                Retry
              </button>
              <button
                :if={processing?(prediction)}
                phx-click="cancel"
                phx-value-id={prediction.id}
              >
                Cancel
              </button>
              <.link navigate={~p"/?prompt=#{prediction.prompt}"}>Regenerate</.link>
              <.link navigate={~p"/?prompt=#{prediction.prompt <> " variation"}"}>Variation</.link>
              <span :if={prediction.status == :failed and prediction.credit_refunded}>
                Credit returned
              </span>
              <span :if={prediction.status == :failed and not prediction.credit_refunded}>
                Needs review
              </span>
              <button phx-click="delete" phx-value-id={prediction.id}>Delete</button>
            </div>
          </div>
        </li>
      </ul>

      <div :if={@has_more?} class="saas-history-load">
        <button class="saas-button saas-button-ghost" phx-click="load-more">Load More</button>
      </div>

      <div :if={not is_nil(@local_user_id) and @prediction_count == 0} class="saas-empty-state">
        <h2>No stickers found</h2>
        <p>Try a different filter, or generate a new sticker from the home page.</p>
        <.link class="saas-button saas-button-primary" navigate={~p"/"}>Create Sticker</.link>
      </div>
    </div>
  </section>
</div>
