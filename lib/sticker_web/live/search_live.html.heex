<section class="saas-section">
  <div class="saas-container">
    <div class="saas-section-head">
      <p class="saas-legal-kicker">Sticker Ideas</p>
      <h1>AI Sticker Search</h1>
      <p class="saas-section-copy">
        Search AI generated stickers for prompt ideas, cute examples, mascot concepts, and
        reusable inspiration.
      </p>
    </div>

    <div class="saas-tool-shell saas-search-tool">
      <.form for={@form} name="sticker-search" id="sticker-search" phx-submit="search">
        <div class="saas-prompt-row">
          <input
            type="text"
            name={@form[:query].name}
            id={@form[:query].id}
            value={Phoenix.HTML.Form.normalize_value("text", @form[:query].value)}
            required="true"
            placeholder="Search sticker ideas: panda, coffee cup, robot mascot..."
            phx-mounted={JS.focus()}
            class="saas-prompt-input"
          />
          <button class="saas-button saas-button-primary" phx-disable-with="Searching...">
            Search Stickers
          </button>
        </div>
      </.form>

      <p class="saas-mini-copy">
        <%= @number_searchable_stickers %> searchable AI stickers are available.
        Use results as inspiration, then regenerate a variation from any prompt.
      </p>
    </div>
  </div>
</section>

<section class="saas-section saas-section-alt">
  <div class="saas-container">
    <div class="saas-section-head">
      <h2>Sticker Search Results</h2>
      <p :if={not is_nil(@elapsed_time) and not @loading} class="saas-section-copy">
        Searched <%= @number_searchable_stickers %> stickers in <%= @elapsed_time / 1000.0 %> seconds.
      </p>
      <p :if={is_nil(@elapsed_time) and not @loading} class="saas-section-copy">
        Enter a topic above to find matching AI sticker ideas.
      </p>
    </div>

    <div :if={@loading} class="saas-loading">
      <img src="/images/loading.png" alt="loading" /> Searching stickers...
    </div>

    <ul
      :if={not @loading}
      id="sticker-list"
      phx-update="stream"
      role="list"
      class="saas-generated-grid"
    >
      <li :for={{id, {prediction, _distance}} <- @streams.results} id={id}>
        <StickerWeb.Components.sticker id={id} prediction={prediction} class="saas-generated-item" />
      </li>
    </ul>
  </div>
</section>
