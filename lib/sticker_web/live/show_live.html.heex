<section class="saas-section">
  <div class="saas-container">
    <div class="saas-detail-grid">
      <div class="saas-detail-art">
        <%= if is_nil(@prediction.sticker_output) do %>
          <div class="saas-detail-loading">
            <span :if={@prediction.status != :failed} class="saas-card-spinner"></span>
            <strong><%= if @prediction.status == :failed, do: "No sticker was created", else: @prediction.status || :starting %></strong>
            <p>
              <%= if @prediction.status == :failed do %>
                The image service did not return a usable result this time.
              <% else %>
                Generation can take a few minutes. This page updates automatically.
              <% end %>
            </p>
            <p :if={@prediction.status == :failed and @prediction.credit_refunded} class="saas-refund-note">
              No credit was consumed. The credit has already been returned.
            </p>
            <p :if={@prediction.status == :failed} class="saas-section-copy">
              Try regenerating, or upload a clearer front-facing portrait with good lighting.
            </p>
          </div>
        <% else %>
          <img src={@prediction.sticker_output} alt={@prediction.prompt} />
        <% end %>
      </div>

      <div class="saas-detail-panel">
        <p class="saas-legal-kicker">Sticker</p>
        <h1><%= @prediction.prompt %></h1>
        <p>
          Sticker-ready artwork for chats, social posts, avatars, and print workflows.
        </p>

        <div class="saas-delivery-grid">
          <div>
            <span>Canvas</span>
            <strong>1024 x 1024 px</strong>
          </div>
          <div>
            <span>Output</span>
            <strong><%= String.upcase(@prediction.output_format || "image") %></strong>
          </div>
          <div>
            <span>Background</span>
            <strong>Sticker-safe</strong>
          </div>
          <div>
            <span>Status</span>
            <strong><%= @prediction.status || :completed %></strong>
          </div>
        </div>

        <div class="saas-detail-actions">
          <a
            :if={@prediction.sticker_output}
            href={~p"/sticker/#{@prediction.id}/download"}
            class="saas-button saas-button-primary"
          >
            Download <%= String.upcase(@prediction.output_format || "Sticker") %>
          </a>
          <a
            :if={@prediction.sticker_output}
            href={~p"/sticker/#{@prediction.id}/download?format=png"}
            class="saas-button saas-button-ghost"
          >
            PNG
          </a>
          <a
            :if={@prediction.sticker_output}
            href={~p"/sticker/#{@prediction.id}/download?format=webp"}
            class="saas-button saas-button-ghost"
          >
            WebP
          </a>
          <a
            :if={@prediction.sticker_output}
            href={@prediction.sticker_output}
            target="_blank"
            class="saas-button saas-button-ghost"
          >
            Open Original
          </a>
          <.link class="saas-button saas-button-ghost" navigate={~p"/?prompt=#{@prediction.prompt}"}>
            Regenerate
          </.link>
          <.link
            :if={@prediction.status == :failed and @prediction.model == "face-to-sticker"}
            class="saas-button saas-button-ghost"
            navigate={~p"/#upload"}
          >
            Upload Again
          </.link>
          <.link class="saas-button saas-button-ghost" navigate={~p"/?prompt=#{@prediction.prompt <> " variation"}"}>
            Make Variation
          </.link>
          <button
            class="saas-button saas-button-ghost"
            phx-click="toggle-favorite"
            phx-value-id={@prediction.id}
          >
            <%= if @prediction.is_favorite, do: "Saved", else: "Save" %>
          </button>
          <button
            :if={owns_prediction?(@current_user, @prediction)}
            class="saas-button saas-button-ghost"
            phx-click="delete"
            phx-value-id={@prediction.id}
          >
            Delete
          </button>
          <a
            :if={@prediction.status == :failed}
            class="saas-button saas-button-ghost"
            href="mailto:support@ai-sticker-maker.com"
          >
            Contact Support
          </a>
        </div>

        <div class="saas-buy-note">
          <strong>Transparent background:</strong>
          Sticker results are optimized for sticker-style use and stored as generated image files.
          Download PNG for broad editing support or WebP for smaller web files. Canvas is generated
          at 1024 x 1024 px unless the upstream model returns a different size. Confirm transparency
          in the downloaded file before print production.
        </div>
      </div>
    </div>
  </div>
</section>

<section class="saas-section saas-section-alt">
  <div class="saas-container">
    <div class="saas-section-head">
      <h2>Similar Stickers</h2>
      <p class="saas-section-copy">Use nearby ideas for variations and new prompts.</p>
    </div>

    <.async_result :let={similar_stickers} assign={@similar_stickers}>
      <:loading>
        <p class="saas-loading"><img src="/images/loading.png" alt="loading" /> Loading similar stickers...</p>
      </:loading>
      <:failed :let={_reason}>
        <p class="saas-section-copy">Similar sticker search is unavailable right now.</p>
      </:failed>

      <ul :if={similar_stickers} id="sticker-list" role="list" class="saas-generated-grid">
        <li :for={{prediction, _distance} <- similar_stickers}>
          <StickerWeb.Components.sticker id={"similar-#{prediction.id}"} prediction={prediction} />
        </li>
      </ul>
    </.async_result>
  </div>
</section>
