<div
  id="home"
  class="saas-home"
  phx-hook="LaunchAnalytics"
  data-session-user-id={@local_user_id}
  data-auth-state={if @current_user, do: "known", else: "guest"}
>
  <section class="saas-hero">
    <div class="saas-container saas-hero-main">
      <div class="saas-hero-intro">
        <div class="saas-hero-copy">
          <span class="saas-eyebrow">3 free generations - no sign-up required</span>
          <h1>AI Sticker Maker for Custom Stickers</h1>

          <p class="saas-lead">
            Turn a prompt or portrait into a clean, expressive sticker. Try it free and download
            sticker-ready PNG or WebP designs.
          </p>

          <div class="saas-hero-actions">
            <a
              href="#generator"
              class="saas-button saas-button-primary saas-hero-primary"
              data-analytics-event="hero_cta_click"
              data-analytics-context="gallery_first_hero"
            >
              Create a sticker
            </a>
            <a
              href="#latest"
              class="saas-button saas-hero-secondary"
              data-analytics-event="hero_examples_click"
              data-analytics-context="gallery_first_hero"
            >
              View examples
            </a>
          </div>

          <ul class="saas-hero-proof" aria-label="AI Sticker Maker benefits">
            <li>3 free guest generations</li>
            <li>PNG and WebP downloads</li>
            <li>Failed generations refund credits</li>
          </ul>
        </div>

        <div class="saas-hero-gallery" aria-label="Featured AI sticker examples">
          <div
            :for={{item, index} <- Enum.with_index(Enum.take(@showcase_items, 4))}
            class={["saas-hero-sticker", "saas-hero-sticker-#{index + 1}"]}
          >
            <img src={item.image} alt={item.alt} />
            <span><%= item.tag %></span>
          </div>
        </div>
      </div>

      <div id="generator" class="saas-generator-workbench">
        <div class="saas-workbench-shell">
          <div class="saas-workbench-topbar">
            <div class="saas-mode-tabs" aria-label="Generator modes">
              <a class="saas-mode-tab active" href="#generator">Text to Sticker</a>
              <a class="saas-mode-tab" href="#upload">Reference face</a>
              <.link class="saas-mode-tab" navigate={~p"/search"}>Search ideas</.link>
            </div>

            <span class="saas-workbench-note">Sticker-ready square output</span>
          </div>

          <.form
            :if={@current_user}
            for={@form}
            id="prediction-form"
            phx-change="validate"
            phx-submit="save"
            data-analytics-event="generation_started"
            data-analytics-context={
              if @prompt_restored?, do: "hero_generator_restored_prompt", else: "hero_generator"
            }
            data-analytics-flow="text_to_sticker"
          >
            <div class="saas-raphael-input">
              <div class="saas-raphael-reference">
                <.face_upload_panel current_user={@current_user} uploads={@uploads} />
              </div>

              <label class="saas-raphael-prompt" for={@form[:prompt].id}>
                <span class="saas-prompt-label">Describe the sticker you want to generate</span>

                <textarea
                  id={@form[:prompt].id}
                  name={@form[:prompt].name}
                  placeholder="Try: cute panda eating cookie, kawaii flower, robot mascot...&#10;Add up to 5 prompts, one per line."
                  required
                  phx-mounted={JS.focus()}
                  class="saas-prompt-input saas-raphael-textarea"
                  data-analytics-input="prompt"
                  data-analytics-context="hero_generator"
                ><%= Phoenix.HTML.Form.normalize_value("textarea", @form[:prompt].value) %></textarea>
              </label>

              <span class="saas-raphael-enhance" aria-disabled="true">AI Enhance</span>

              <div class="saas-raphael-footer">
                <span class="saas-raphael-credit">Credits: <%= @current_user.credits %></span>

                <button
                  name="submit"
                  value="generate"
                  phx-disable-with="Generating..."
                  class="saas-button saas-button-primary saas-generate-button"
                  data-analytics-event="text_generation_attempt"
                  data-analytics-context={
                    if @prompt_restored?,
                      do: "hero_generator_restored_prompt",
                      else: "hero_generator"
                  }
                  data-analytics-flow="text_to_sticker"
                >
                  Generate
                </button>
              </div>
            </div>
          </.form>

          <.form
            :if={is_nil(@current_user)}
            for={@form}
            id="prediction-form"
            phx-change="validate"
            phx-submit="save"
            data-analytics-event="generation_started"
            data-analytics-context="hero_generator_guest"
            data-analytics-flow="text_to_sticker"
          >
            <div class="saas-raphael-input">
              <div class="saas-raphael-reference">
                <.face_upload_panel current_user={@current_user} uploads={@uploads} />
              </div>

              <label class="saas-raphael-prompt" for={@form[:prompt].id}>
                <span class="saas-prompt-label">Describe the sticker you want to generate</span>

                <textarea
                  id={@form[:prompt].id}
                  name={@form[:prompt].name}
                  placeholder="Try: cute panda eating cookie, kawaii flower, robot mascot...&#10;Add up to 5 prompts, one per line."
                  required
                  phx-mounted={JS.focus()}
                  class="saas-prompt-input saas-raphael-textarea"
                  data-analytics-input="prompt"
                  data-analytics-context="hero_generator_guest"
                ><%= Phoenix.HTML.Form.normalize_value("textarea", @form[:prompt].value) %></textarea>
              </label>

              <span class="saas-raphael-enhance" aria-disabled="true">AI Enhance</span>

              <div class="saas-raphael-footer">
                <% remaining = guest_trial_remaining(@guest_trial) %>
                <%= if remaining > 0 do %>
                  <span class="saas-raphael-credit">
                    No account needed to try · <%= remaining %> free guest generations left
                  </span>
                <% else %>
                  <.link
                    navigate={~p"/users/register"}
                    class="saas-raphael-credit"
                    data-analytics-event="guest_to_signup_click"
                    data-analytics-context="generator_trial_exhausted"
                  >
                    Free trial used · Create an account to keep your stickers
                  </.link>
                <% end %>

                <button
                  name="submit"
                  value="generate"
                  phx-disable-with="Generating..."
                  class="saas-button saas-button-primary saas-generate-button"
                  data-analytics-event="text_generation_attempt"
                  data-analytics-context="hero_generator_guest"
                  data-analytics-flow="text_to_sticker"
                >
                  Generate
                </button>
              </div>
            </div>
          </.form>
        </div>

        <div class="saas-workbench-trust" aria-label="AI Sticker Maker trust signals">
          <span class="saas-status-chip">Generated examples</span>
          <span class="saas-status-chip">Account-linked history and downloads</span>
          <span class="saas-status-chip">Support and billing help</span>
        </div>
      </div>
    </div>
  </section>

  <section :if={not is_nil(@local_user_id)} class="saas-section">
    <div class="saas-container">
      <div class="saas-section-head">
        <h2>Your Sticker Generations</h2>

        <p class="saas-section-copy">
          Your current session results appear here while stickers are baking.
        </p>
      </div>

      <ul id="my-predictions" phx-update="stream" role="list" class="saas-generated-grid">
        <li :for={{id, prediction} <- @streams.my_predictions} id={id}>
          <StickerWeb.Components.sticker
            id={id}
            prediction={prediction}
            class="saas-generated-item"
          />
        </li>
      </ul>
    </div>
  </section>

  <section class="saas-section saas-section-alt">
    <div class="saas-container">
      <div class="saas-section-head">
        <h2>Free AI Sticker Generator Online</h2>

        <p class="saas-section-copy">
          Keep the tool in the first screen: enter a prompt, upload a face, or search sticker
          ideas without jumping between pages.
        </p>
      </div>

      <div class="saas-feature-grid">
        <article class="saas-tile">
          <div class="saas-icon">T</div>

          <h3>Text to sticker</h3>

          <p>Describe an idea and generate a sticker-style image from a short prompt.</p>
        </article>

        <article class="saas-tile">
          <div class="saas-icon">F</div>

          <h3>Face to sticker</h3>

          <p>Upload a portrait and create a playful sticker version for profiles and posts.</p>
        </article>

        <article class="saas-tile">
          <div class="saas-icon">S</div>

          <h3>Sticker search</h3>

          <p>Search the generated sticker library once your site has enough saved results.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="latest" class="saas-section">
    <div class="saas-container">
      <div class="saas-section-head">
        <h2>Featured AI Stickers</h2>
        <p class="saas-section-copy">
          Curated sticker examples help visitors see portrait, character, and animal styles at a
          glance.
        </p>
      </div>

      <div class="saas-static-sticker-grid saas-showcase-grid">
        <%= for item <- @showcase_items do %>
          <%= if item.type == :prediction do %>
            <.link
              navigate={~p"/sticker/#{item.id}"}
              class="saas-sticker-card saas-real-sticker-card"
            >
              <div class="saas-sticker-art">
                <img src={item.image} alt={item.alt} class="saas-showcase-image" />
              </div>
              <div class="saas-sticker-meta">
                <div class="saas-sticker-label"><%= item.label %></div>
                <div class="saas-tag"><%= item.tag %></div>
              </div>
            </.link>
          <% else %>
            <article class="saas-sticker-card saas-fallback-sticker-card">
              <div class="saas-sticker-art">
                <img src={item.image} alt={item.alt} class="saas-showcase-image" />
              </div>
              <div class="saas-sticker-meta">
                <div class="saas-sticker-label"><%= item.label %></div>
                <div class="saas-tag"><%= item.tag %></div>
              </div>
            </article>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <section id="pricing" class="saas-section saas-section-alt">
    <div class="saas-container">
      <div class="saas-section-head">
        <h2>Simple credits for AI sticker creation</h2>

        <p class="saas-section-copy">
          Start with 3 free credits, then sign in to manage future credits and downloads.
        </p>
      </div>

      <div class="saas-pricing-grid">
        <article class="saas-tile">
          <h3>Free</h3>

          <div class="saas-price">$0</div>

          <p>3 free credits for testing prompts and trying the AI sticker maker.</p>

          <.link
            class="saas-button saas-button-ghost saas-plan-button"
            navigate={~p"/users/register"}
            data-analytics-event="registration_cta_click"
            data-analytics-context="home_free_plan"
          >
            Start Free
          </.link>
        </article>

        <article class="saas-tile">
          <h3>Starter</h3>

          <div class="saas-price">$4.99</div>
          <p>50 credits for light use, social posts, and quick experiments.</p>

          <.link
            class="saas-button saas-button-primary saas-plan-button"
            navigate={~p"/pricing"}
            data-analytics-event="pricing_cta_click"
            data-analytics-context="home_starter_plan"
          >
            Buy Credits
          </.link>
        </article>

        <article class="saas-tile">
          <h3>Creator</h3>

          <div class="saas-price">$9.99</div>

          <p>150 credits for frequent sticker generation and creative projects.</p>

          <.link
            class="saas-button saas-button-ghost saas-plan-button"
            navigate={~p"/pricing"}
            data-analytics-event="pricing_cta_click"
            data-analytics-context="home_creator_plan"
          >
            Buy Credits
          </.link>
        </article>
      </div>

      <div class="saas-hint-row" aria-label="AI Sticker Maker purchase trust signals">
        <span class="saas-chip">Secure checkout</span>
        <span class="saas-chip">Account-linked credits</span>
        <span class="saas-chip">Refund policy available</span>
      </div>
    </div>
  </section>

  <section id="faq" class="saas-section">
    <div class="saas-container">
      <div class="saas-section-head">
        <h2>AI Sticker Maker FAQ</h2>

        <p class="saas-section-copy">
          Quick answers for people comparing AI sticker generators online.
        </p>
      </div>

      <div class="saas-faq">
        <details open>
          <summary>What is an AI sticker maker?</summary>

          <p>
            An AI sticker maker turns a text prompt or portrait into a sticker-style image you can
            use for avatars, chats, thumbnails, and creative projects.
          </p>
        </details>

        <details>
          <summary>Is this AI sticker generator free?</summary>

          <p>
            New accounts start with 3 free credits. Each text or face sticker generation uses 1
            credit, and more credits can be added later.
          </p>
        </details>

        <details>
          <summary>Why is my sticker still loading?</summary>

          <p>
            AI generation can take time, and public HTTPS webhooks are required in production for
            reliable completion callbacks.
          </p>
        </details>
      </div>
    </div>
  </section>
</div>
